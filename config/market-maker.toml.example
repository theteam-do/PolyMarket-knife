# Market Maker 配置文件

[polygon]
rpc_url = "wss://polygon-bor-rpc.publicnode.com"
private_key = "YOUR_PRIVATE_KEY_HERE"  # ⚠️ 不要提交到版本控制

[exchange]
api_key = "YOUR_API_KEY"
api_secret = "YOUR_API_SECRET"

[strategy]
markets = []  # 市场合约地址列表
spread_bps = 100              # 1% 价差 (100 = 1%)
order_size_usd = 1000         # 单笔订单大小
refresh_interval_ms = 100     # 刷新间隔
skew_inventory = true         # 启用库存偏斜

[risk]
max_position_usd = 10000      # 最大持仓
max_loss_per_day = 500        # 日最大亏损
stop_loss_pct = 5.0           # 止损百分比
max_orders = 10               # 最大订单数
