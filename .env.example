# 环境变量配置模板
# ⚠️ 不要提交包含真实凭证的 .env 文件到版本控制！
# ⚠️ 复制此文件为 .env 或 .env.testnet 并填入真实值

# Polymarket 私钥 (用于 CLOB API 签名)
# ⚠️ 重要：妥善保管，不要泄露！
POLYMARKET_PRIVATE_KEY="0xYOUR_PRIVATE_KEY_HERE"

# Polygon RPC URL
# 测试网：https://rpc-mumbai.maticvigil.com
# 主网：https://polygon-rpc.com
POLYGON_RPC_URL="https://polygon-rpc.com"

# Polygon WebSocket RPC (可选，用于实时监控)
POLYGON_WS_RPC_URL="wss://polygon-rpc.com/ws"

# CLOB API 主机
# 测试网：https://testnet-clob.polymarket.com
# 主网：https://clob.polymarket.com
CLOB_HOST="https://clob.polymarket.com"

# CLOB WebSocket URL (可选)
CLOB_WS_MARKET_URL="wss://ws-subscriptions-clob.polymarket.com/ws/market"
CLOB_WS_USER_URL="wss://ws-subscriptions-clob.polymarket.com/ws/user"

# 钱包地址 (可选，用于验证)
WALLET_ADDRESS="0xYOUR_WALLET_ADDRESS_HERE"

# 日志级别 (可选)
RUST_LOG="info"
